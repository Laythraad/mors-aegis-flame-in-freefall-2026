{
  "name": "mors-aegis",
  "version": "3.0.0-alpha.14",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "build:client": "esbuild public/app.js --bundle --format=iife --target=es2017 --external:/vendor/* --outfile=public/app.bundle.js",
    "test": "node --test",
    "data:fetch": "npm run data:tables",
    "data:normalize": "node scripts/fetch-psi69.mjs --offline",
    "data:audit": "node scripts/audit-challenge-data.mjs",
    "data:inventory": "node scripts/fetch-psi-investigation-inventory.mjs",
    "data:file-index": "node scripts/fetch-psi-file-index.mjs && node scripts/refresh-psi-table-versions.mjs",
    "data:tables": "node scripts/refresh-psi-table-versions.mjs && node scripts/fetch-psi-experimental-tables.mjs",
    "format": "npx --yes prettier@3 --write public/app.js public/lib",
    "format:check": "npx --yes prettier@3 --check public/app.js public/lib",
    "lint": "npx --yes eslint@10 ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
