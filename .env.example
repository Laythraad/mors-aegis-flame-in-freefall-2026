# Copy to .env for server configuration. Values stay on the server.
PORT=4173
HOST=127.0.0.1
GEMINI_API_KEY=
MORS_OLLAMA_BASE_URL=
MORS_OLLAMA_MODEL=qwen2.5:3b
MORS_CREDENTIALS_FILE=
# Required when HOST is not loopback, including Docker. Use at least 12 characters; prefer a random 32+ character value for public deployments.
MORS_ACCESS_TOKEN=
# Optional exact HTTPS origins for a trusted local reverse proxy such as Cloudflare Tunnel.
# Comma-separate origins; do not add a path or wildcard.
# MORS_TRUSTED_ORIGINS=https://your-deployment.example
# Set to 1 when the browser reaches the app over HTTPS through that proxy.
# MORS_COOKIE_SECURE=1
# Public research mode; pages and GET APIs need no login, only trusted Copilot POST is allowed.
MORS_PUBLIC_READONLY=0
